---
import BaseLayout from "./BaseLayout.astro";
import DataChart from "../components/DataChart.astro";
import FormulaReference from "../components/FormulaReference.astro";
import SourceQuote from "../components/SourceQuote.astro";

interface Source {
  name: string;
  published?: string;
  url: string;
}

interface Formula {
  name: string;
  expression: string;
  note?: string;
  source: Source;
}

interface Quote {
  quote: string;
  note?: string;
  source: Source;
}

interface ChartSeries {
  name: string;
  values: number[];
}

interface ChartData {
  title: string;
  description?: string;
  type: "line" | "bar";
  xLabel?: string;
  yLabel?: string;
  unit?: string;
  labels: string[];
  series: ChartSeries[];
  source: Source;
  note?: string;
  yMin?: number;
  yMax?: number;
}

interface PrincipleLink {
  chapter: string;
  title: string;
  href: string;
  note?: string;
}

interface Prerequisites {
  level: "basic" | "intermediate" | "advanced";
  subjects: { name: string; note?: string }[];
  note?: string;
}

interface Props {
  title: string;
  dek: string;
  date: Date;
  section: "alert" | "daily" | "knowledge";
  kind?: "feature" | "principle";
  lang: "zh" | "en";
  topics?: string[];
  counterpart?: string;
  prerequisites?: Prerequisites;
  principles?: PrincipleLink[];
  sources?: Source[];
  formulas?: Formula[];
  quotes?: Quote[];
  charts?: ChartData[];
}

const {
  title,
  dek,
  date,
  section,
  kind = "feature",
  lang,
  topics = [],
  counterpart,
  prerequisites,
  principles = [],
  sources = [],
  formulas = [],
  quotes = [],
  charts = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
const sectionLabel = section === "alert" ? "重大事件" : section === "daily" ? "每日简报" : "知识漫游";
const sectionEnglish = section === "alert"
  ? "MAJOR ALERT"
  : section === "daily"
    ? "DAILY BRIEF"
    : kind === "principle"
      ? "KNOWLEDGE / PRINCIPLE"
      : "KNOWLEDGE BRIEF";
const counterpartHref = counterpart
  ? `${base}${counterpart.replace(/^\//, "")}/`.replace(/\/{2,}/g, "/")
  : undefined;
const sourceCount = sources.length;
const principleHref = (href: string) => `${base}${href.replace(/^\//, "")}/`.replace(/\/{2,}/g, "/");
const levelLabel = prerequisites
  ? {
      basic: lang === "zh" ? "基础" : "Basic",
      intermediate: lang === "zh" ? "中等" : "Intermediate",
      advanced: lang === "zh" ? "进阶" : "Advanced",
    }[prerequisites.level]
  : undefined;
---

<BaseLayout title={title} description={dek}>
  <div class="site-shell article-wrap">
    <article class="article-main">
      <header class="article-header">
        <div class="article-kicker-row">
          <div>
            <div class="eyebrow">{sectionEnglish}</div>
            <div class="section-label">{sectionLabel}{kind === "principle" ? " · 原理" : ""}</div>
          </div>
          <div class="article-number">{date.toISOString().slice(0, 10).replaceAll("-", " / ")}</div>
        </div>

        <h1>{title}</h1>
        <div class="article-dek">{dek}</div>

        <div class="article-meta">
          <span>{date.toISOString().slice(0, 10)}</span>
          <span>{lang === "zh" ? "中文版" : "English Edition"}</span>
          {topics.map((topic) => <span>{topic}</span>)}
        </div>

        {counterpartHref && (
          <a class="lang-link" href={counterpartHref}>
            {lang === "zh" ? "Read in English →" : "阅读中文版 →"}
          </a>
        )}
      </header>

      {section === "knowledge" && kind === "feature" && principles.length > 0 && (
        <section class="principle-map" aria-label={lang === "zh" ? "配套原理" : "Related principles"}>
          <div class="principle-map__head">
            <span>{lang === "zh" ? "配套原理" : "RELATED PRINCIPLES"}</span>
            <strong>{lang === "zh" ? "每章对应一篇原理文" : "One principle essay for each chapter"}</strong>
          </div>
          <div class="principle-map__grid">
            {principles.map((item, index) => (
              <a class="principle-map__item" href={principleHref(item.href)}>
                <span class="principle-map__index">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <small>{item.chapter}</small>
                  <h3>{item.title}</h3>
                  {item.note && <p>{item.note}</p>}
                </div>
                <span class="principle-map__arrow">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {prerequisites && (
        <section class="prerequisite-box" aria-label={lang === "zh" ? "阅读前提" : "Before you read"}>
          <div class="prerequisite-box__head">
            <span>{lang === "zh" ? "阅读前提" : "BEFORE YOU READ"}</span>
            <strong>{levelLabel}</strong>
          </div>
          <p class="prerequisite-box__intro">
            {lang === "zh"
              ? "这篇文章会用到以下背景。不了解也可以继续读，正文会补关键定义；若想跟完整推导，先熟悉这些内容会更顺畅。"
              : "This article uses the background below. You can still read on—the key definitions are introduced in the text—but the full derivation is easier if these ideas are familiar."}
          </p>
          <ul>
            {prerequisites.subjects.map((subject) => (
              <li>
                <strong>{subject.name}</strong>
                {subject.note && <span>{subject.note}</span>}
              </li>
            ))}
          </ul>
          {prerequisites.note && <p class="prerequisite-box__note">{prerequisites.note}</p>}
        </section>
      )}

      {quotes.length > 0 && (
        <section class="quote-stack" aria-label={lang === "zh" ? "原文摘录" : "Source excerpts"}>
          {quotes.map((item) => <SourceQuote item={item} />)}
        </section>
      )}

      <div class="prose"><slot /></div>

      {charts.length > 0 && (
        <section class="article-extra-section">
          <div class="extra-section-head">
            <span>DATA</span>
            <h2>{lang === "zh" ? "图表与数据" : "Charts & data"}</h2>
          </div>
          <div class="chart-stack">
            {charts.map((chart) => <DataChart chart={chart} />)}
          </div>
        </section>
      )}

      {formulas.length > 0 && (
        <section class="article-extra-section">
          <div class="extra-section-head">
            <span>METHOD</span>
            <h2>{lang === "zh" ? "公式与来源" : "Formula provenance"}</h2>
          </div>
          <div class="formula-grid">
            {formulas.map((formula) => <FormulaReference formula={formula} />)}
          </div>
        </section>
      )}
    </article>

    <aside class="article-aside">
      <div class="aside-block">
        <div class="aside-label">{lang === "zh" ? "文档" : "Document"}</div>
        <div class="aside-stat">
          <strong>{sourceCount.toString().padStart(2, "0")}</strong>
          <span>{lang === "zh" ? "个来源" : "sources"}</span>
        </div>
      </div>

      <div class="aside-block">
        <h3>{lang === "zh" ? "来源" : "Sources"}</h3>
        {sources.length > 0 ? (
          <ol class="source-list">
            {sources.map((source, index) => (
              <li>
                <span class="source-index">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <a href={source.url} target="_blank" rel="noreferrer">{source.name}</a>
                  {source.published && <div>{source.published}</div>}
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty">{lang === "zh" ? "暂无来源列表" : "No source list"}</div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
